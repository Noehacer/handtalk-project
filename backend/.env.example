# Copia este archivo como .env y ajusta los valores

# Clave secreta para firmar los JWT (cámbiala en producción)
SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Desarrollo local:  ALLOWED_ORIGINS=*
# Producción:        ALLOWED_ORIGINS=https://tu-app.onrender.com,https://otro-dominio.com
# Nota: * solo es válido cuando no se usan cookies de sesión (este proyecto usa JWT en headers).
ALLOWED_ORIGINS=*

# Anthropic API (requerido para traducción LSM→español)
ANTHROPIC_API_KEY=sk-ant-...

# Ajustes opcionales del AI upgrade
MODEL_VERSION=v2
SEMANTIC_THRESHOLD=0.65
WS_STATIC_THRESHOLD=0.6
WS_DYNAMIC_THRESHOLD=0.7
